# ─── Columnist env ──────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local to git.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role key — SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for canonical URLs, OG images, sitemap)
NEXT_PUBLIC_SITE_URL=https://columnist.site
